# Copy to /opt/protrack/.env and chmod 600. Replace every CHANGE_ME value.
NODE_ENV=production
PORT=4000
DB_DRIVER=pg
SEED_DEMO=0
READ_AUTH=1
REGISTRATION_OPEN=0
TRUST_PROXY=loopback,172.30.0.11
JWT_SECRET=CHANGE_ME_LONG_RANDOM_VALUE
POSTGRES_DB=protrack
POSTGRES_USER=protrack
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_VALUE
PG_POOL_MAX=5
PVE_BACKUP_REQUIRED=1
