# Salin ke .env yang tidak dilacak Git, kemudian isi nilai sesuai lingkungan.
# Jangan menaruh kredensial asli dalam file contoh ini.

# Produksi memerlukan PostgreSQL persisten dan JWT_SECRET yang kuat.
# Isi DATABASE_URL dan JWT_SECRET sebelum menjalankan server produksi.
# Pada Vercel/Supabase gunakan transaction pooler port 6543 dengan SSL.
# Pada server sendiri pilih koneksi PostgreSQL sesuai jaringan dan kebutuhan
# LISTEN. Jangan memakai PGlite in-memory sebagai penyimpanan produksi.
NODE_ENV=production
DB_DRIVER=pg
DATABASE_URL=
JWT_SECRET=
PORT=4000

# Bootstrap normal hanya membuat skema. Tidak ada akun demo, nama unit rekaan,
# atau transaksi contoh. Registrasi publik ditutup secara default.
SEED_DEMO=0
REGISTRATION_OPEN=0

# Untuk pengembangan lokal tanpa PostgreSQL, ubah NODE_ENV menjadi development
# dan DB_DRIVER menjadi pglite. Data in-memory hilang ketika proses dibuat
# ulang; penggunaan lokal tersebut tetap tidak mengaktifkan seed otomatis.
#
# Fixture hanya boleh dijalankan pada database test terisolasi dengan kedua
# flag berikut sekaligus: NODE_ENV=test dan SEED_DEMO=1.
# Suite pengujian menyiapkan environment/fixture sendiri. Untuk suite PostgreSQL,
# UNIT_TEST_PG_URL harus menunjuk database test yang dapat dibuang, bukan produksi.
# Mengisi DEMO_*_EMAIL atau DEMO_*_PASS tidak mengaktifkan seed normal.
#
# Seluruh API bisnis wajib login dan mengikuti unit/capability pada semua
# lingkungan. READ_AUTH=0 tidak membuka endpoint baca atau melewati scope.
# Akun pusat awal, promosi identitas terverifikasi, nama unit resmi, dan
# keanggotaan diatur sesuai docs/self-host.md dan docs/data-awal.md.

# CORS kosong berarti same-origin. Isi daftar origin dipisahkan koma hanya
# bila frontend memang di-host pada origin berbeda.
CORS_ORIGIN=

# SSL mengikuti sslmode pada DATABASE_URL; DB_SSL=1 dapat memaksakan SSL.
# PostgreSQL lokal tanpa SSL tidak memerlukan pengaturan ini.
DB_SSL=

# Pool koneksi mengikuti jenis koneksi secara otomatis. Override hanya bila
# diperlukan: PG_POOL_MAX, PG_IDLE_TIMEOUT_MS, dan PG_CONNECT_TIMEOUT_MS.

# Integrasi WhatsApp Fonnte untuk pengiriman rekap agenda.
# Jika kosong, pengiriman ke grup WhatsApp tidak tersedia.
FONNTE_TOKEN=
FONNTE_TARGET=
