# Postgres connection string (Neon free tier recommended)
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# --- Demo / seed account credentials (LOCAL dev only) ---
# Copy this file to `.env` and fill in your own values. `.env` is git-ignored,
# so real passwords stay out of the repository. The local PGlite server reads
# these to create the demo login accounts.
DEMO_ADMIN_EMAIL=admin@pln.local
DEMO_ADMIN_PASS=change-me
DEMO_VENDOR_EMAIL=vendor@pln.local
DEMO_VENDOR_PASS=change-me
DEMO_DALKON_EMAIL=dalkon@pln.local
DEMO_DALKON_PASS=change-me
DEMO_ENJIN_EMAIL=enjin@pln.local
DEMO_ENJIN_PASS=change-me

# Demo credentials exposed to the frontend (VITE_ prefix) for the quick-login
# buttons on the login page.
VITE_DEMO_ADMIN_PASS=change-me
VITE_DEMO_VENDOR_PASS=change-me
VITE_DEMO_DALKON_PASS=change-me
VITE_DEMO_ENJIN_PASS=change-me
