# Salin file ini ke `.env` (git-ignored) lalu isi nilainya.
#
# ---------------------------------------------------------------------------
# MODE DEMO (default, zero-config)
# ---------------------------------------------------------------------------
# Tanpa konfigurasi apa pun, database in-memory PGlite di-auto-seed 8 proyek
# demo + akun demo pada request pertama — data hilang saat server restart.
#
# ---------------------------------------------------------------------------
# MODE PRODUKSI (server sendiri / mini PC + Supabase / Postgres lokal)
# ---------------------------------------------------------------------------
# Wajib diisi semua saat go public:
#
#   NODE_ENV=production
#   JWT_SECRET=<nilai acak panjang>        # kunci tanda-tangan token; tanpa ini
#                                          # server MENOLAK start di produksi
#   DB_DRIVER=pg
#   DATABASE_URL=postgresql://...          # Supabase: pakai Session pooler port 5432
#                                          # (bukan 6543 — advisory lock & IPv4)
#   DEMO_ADMIN_PASS=<kata sandi kuat>      # akun admin awal; kata sandi demo
#                                          # (admin123 dst.) TIDAK diizinkan di
#                                          # produksi — akun tanpa env dilewati
#
#   # alternatif: kosongkan semua DEMO_*_PASS + SEED_DEMO=0, lalu buat admin:
#   #   npm run db:create-admin -- admin@domain.com "KataSandiKuat"
#
# Opsi lain:
#   READ_AUTH=0            # matikan kewajiban login untuk endpoint baca API
#                          # (default: AKTIF di NODE_ENV=production)
#   CORS_ORIGIN=https://a.example.com   # izinkan frontend lintas origin
#                          # (default: same-origin saja; dev lewat proxy Vite,
#                          #  produksi lewat nginx → cukup kosongkan)
#   DB_SSL=1               # paksa SSL koneksi Postgres; default: ikut
#                          # ?sslmode=require di DATABASE_URL (Supabase/Vercel
#                          # sudah menyertakannya; Postgres lokal tanpa SSL
#                          # biarkan kosong)
#   SEED_DEMO=0            # jangan seed proyek & akun demo sama sekali
#   PORT=4000              # port API (default 4000)

# --- WhatsApp (Fonnte) integration for agenda rekap ---
# FONNTE_TOKEN: token API dari dashboard fonnte.com
# FONNTE_TARGET: nomor WA (628xxx) atau ID grup yang menerima rekap
# Apabila dikosongkan, tombol "Kirim ke WA Grup" akan dinonaktifkan.
FONNTE_TOKEN=
FONNTE_TARGET=

# --- Demo / seed account credentials (LOCAL dev only) ---
# Kata sandi fallback (admin123 dst.) hanya berlaku di development. Di
# NODE_ENV=production akun yang DEMO_*_PASS-nya kosong akan dilewati.
DEMO_ADMIN_EMAIL=admin@pln.local
DEMO_ADMIN_PASS=
DEMO_VENDOR_EMAIL=vendor@pln.local
DEMO_VENDOR_PASS=
DEMO_DALKON_EMAIL=dalkon@pln.local
DEMO_DALKON_PASS=
DEMO_ENJIN_EMAIL=enjin@pln.local
DEMO_ENJIN_PASS=
DEMO_STAFF_EMAIL=staff@pln.local
DEMO_STAFF_PASS=
